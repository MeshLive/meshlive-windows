<?xml version="1.0" encoding="utf-8"?>
<!--
  MeshLive MSIX manifest template. Build-ReleasePackage.ps1 fills the
  double-brace tokens from packaging/identity.json and Cargo.toml. The identity is a
  placeholder until the Store name is reserved; never put a personal name here.
  Capabilities and their reasons: packaging/CERTIFICATION.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{IDENTITY_PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MeshLive</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Private voice and video calls with people nearby over Bluetooth, without internet or a phone network.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="MeshLive" Executable="meshlive.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MeshLive"
        Description="Private voice and video calls with people nearby over Bluetooth"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Settings > Start with Windows (off until the user turns it on; src/startup.rs). -->
        <uap5:Extension Category="windows.startupTask" Executable="meshlive.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="MeshLiveStartup" Enabled="false" DisplayName="MeshLive" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
