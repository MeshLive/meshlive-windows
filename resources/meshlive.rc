// Windows resources of meshlive.exe: the app icon (made from assets/icon.png,
// see assets/PROVENANCE.md) and version information. build.rs compiles this
// with the SDK's rc.exe; VER_* come from Cargo.toml.
// No #include: the constants are written out (VS_VERSION_INFO 1, VOS_NT_WINDOWS32
// 0x40004, VFT_APP 0x1), so rc.exe needs no SDK include path.

1 ICON "meshlive.ico"

1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MeshLive"
            VALUE "FileDescription", "MeshLive"
            VALUE "FileVersion", VER_TEXT
            VALUE "InternalName", "meshlive"
            VALUE "OriginalFilename", "meshlive.exe"
            VALUE "ProductName", "MeshLive"
            VALUE "ProductVersion", VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
